generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String       @id @default(uuid())
  name        String       @default("GREATCAMPUS")
  slug        String       @unique @default("greatcampus")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assessments Assessment[]
  admins      Admin[]
}

model Admin {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  username  String   @unique
  password  String
  name      String   @default("HR Administrator")
  role      String   @default("ADMIN") // "SUPER_ADMIN", "ADMIN", "RECRUITER"
  createdAt DateTime @default(now())
}

model Assessment {
  id                   String              @id @default(uuid())
  tenantId             String
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                 String
  slug                 String              @unique
  description          String?
  durationMins         Int                 @default(45)
  passingPercentage    Float               @default(50.0)
  maxProctorWarnings   Int                 @default(3)
  enableTabSwitch      Boolean             @default(true)
  enableFullscreen     Boolean             @default(true)
  enableCopyPaste      Boolean             @default(true)
  status               String              @default("ACTIVE") // ACTIVE, DRAFT, INACTIVE, EXPIRED
  activeUntil          DateTime?
  subjects             AssessmentSubject[]
  candidates           Candidate[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model AssessmentSubject {
  id           String           @id @default(uuid())
  assessmentId String
  assessment   Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  name         String           // e.g. "Banking & Financial Awareness", "Management & Leadership"
  displayOrder Int              @default(0)
  sections     SubjectSection[]
  createdAt    DateTime         @default(now())
}

model SubjectSection {
  id                 String            @id @default(uuid())
  subjectId          String
  subject            AssessmentSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name               String            // e.g. "General Banking", "RBI Guidelines"
  questionsToAsk     Int               @default(5)
  displayOrder       Int               @default(0)
  questions          Question[]
  createdAt          DateTime          @default(now())
}

model Question {
  id               String            @id @default(uuid())
  sectionId        String
  section          SubjectSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  question         String
  optionA          String
  optionB          String
  optionC          String
  optionD          String
  correctAnswer    String            // "A", "B", "C", "D"
  marks            Float             @default(1.0)
  status           String            @default("ACTIVE")
  attemptQuestions AttemptQuestion[]
  submissions      Submission[]
  createdAt        DateTime          @default(now())
}

model Candidate {
  id             String        @id @default(uuid())
  assessmentId   String
  assessment     Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  name           String
  email          String
  phone          String
  applicationId  String?       // Headstart CRM Application ID (not unique to allow multiple exams per candidate)
  crmCandidateId String?       // Headstart CRM Candidate ID
  referenceId    String        @unique
  status         String        @default("REGISTERED") // REGISTERED, IN_PROGRESS, COMPLETED, DISQUALIFIED
  attempts       ExamAttempt[]
  createdAt      DateTime      @default(now())
}

model IntegrationConfig {
  id                       String   @id @default(uuid())
  tenantId                 String   @unique
  crmBaseUrl               String   @default("https://api.headstartcrm.com")
  crmApiKey                String?  
  api1Endpoint             String   @default("/api/candidates/verify")
  api2Endpoint             String   @default("/api/candidates/check-assignment")
  webhookStatusUrl         String?  
  webhookResultUrl         String?  
  webhookReportUrl         String?  
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model ExamAttempt {
  id                         String            @id @default(uuid())
  candidateId                String
  candidate                  Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status                     String            @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, DISQUALIFIED, EXPIRED
  durationMinsSnapshot       Int
  passingPercentageSnapshot  Float
  maxProctorWarningsSnapshot Int
  startedAt                  DateTime          @default(now())
  submittedAt                DateTime?
  score                      Float             @default(0)
  totalPossibleScore         Float             @default(0)
  percentage                 Float             @default(0)
  isPassed                   Boolean           @default(false)
  warningCount               Int               @default(0)
  attemptQuestions           AttemptQuestion[]
  submissions                Submission[]
  proctoringLogs             ProctoringLog[]
  screenshots                ProctoringScreenshot[]
}

model AttemptQuestion {
  id            String      @id @default(uuid())
  attemptId     String
  attempt       ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  subjectId     String
  sectionId     String
  questionOrder Int
  marks         Float       @default(1.0)
}

model Submission {
  id             String      @id @default(uuid())
  attemptId      String
  attempt       ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption String?
  isCorrect      Boolean     @default(false)
  timeTakenSec   Int         @default(0)
}

model ProctoringLog {
  id          String      @id @default(uuid())
  attemptId   String
  attempt     ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  eventType   String      // "TAB_SWITCH", "FULLSCREEN_EXIT", "COPY_PASTE", "RIGHT_CLICK", "FACE_NOT_DETECTED", "MULTIPLE_FACES", "CAMERA_OFF"
  details     String?
  timestamp   DateTime    @default(now())
}

model ProctoringScreenshot {
  id          String      @id @default(uuid())
  attemptId   String
  attempt     ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  type        String      // "SCHEDULED" | "WARNING"
  eventType   String?     // "FACE_NOT_DETECTED" | "MULTIPLE_FACES" | "CAMERA_OFF" | "FACE_NOT_VISIBLE" | "TAB_SWITCH"
  imageUrl    String      // Relative URL / path to saved image
  capturedAt  DateTime    @default(now())
}
